# OpenRouter API
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_MODEL=anthropic/claude-3-haiku

# FAISS
TOP_K_RESULTS=10

# Debate
DEBATE_ROUNDS=3

# Security
JWT_SECRET=generate-a-random-secret-here
FRONTEND_URL=http://localhost:3000
ENABLE_API_KEY_AUTH=false
API_KEY=
ENABLE_RATE_LIMITING=true

# Database
DATABASE_URL=

# Logging
LOG_LEVEL=INFO
